/* rs-theme-name: txtheme */
/* rs-theme-is-dark: TRUE */
/* GENERATED by txtheme::build_theme() from R/aaa-palette.R -- do not edit.

   The dark RStudio theme: the courses' code colours, in the editor the students write in.
   Install: rstudioapi::addTheme("txtheme.rstheme", apply = TRUE). Plain CSS, so no
   conversion and no package beyond rstudioapi.
   */

/* the editor, its markers and its popups */
.ace_editor, .ace_editor_theme { background-color: #1f1f1f; color: #CDCBBC; }
.ace_gutter { background-color: #1f1f1f; color: #8b8a8d; }
.ace_print-margin { background: #3e4451; width: 1px; }
.ace_cursor { color: #78dce8; }
.ace_marker-layer .ace_selection { background: rgba(97,175,239,0.3); }
.ace_selection.ace_start { box-shadow: 0 0 3px 0px #1f1f1f; border-radius: 2px; }
.ace_marker-layer .ace_active-line { background: rgba(120,220,232,0.12); }
.ace_marker-layer .ace_selected-word { border: 1px solid #939293; }
.ace_bracket { background-color: rgba(147,146,147,0.45); margin: 0 !important; border: 0 !important; }
.ace_marker-layer .ace_step { background: rgba(230,174,2,0.3); }
.ace_invisible { color: #3e4451; }
.ace_indent-guide { background: linear-gradient(to left, #3e4451 1px, transparent 1px, transparent); }
.ace_fold { background-color: #61afef; border-color: #CDCBBC; }
.ace_marker-layer .ace_find_line { background-color: #282c34; position: absolute; z-index: -1; }
.ace_marker-layer .ace_foreign_line { background-color: #282c34; position: absolute; z-index: -1; }
.ace_marker-layer .ace_active_debug_line { background-color: rgba(230,174,2,0.25); position: absolute; z-index: -1; }
.ace_console_error { background-color: rgba(255,97,136,0.12); }
.nocolor.ace_editor .ace_line span { color: #ff6188 !important; }
.ace_heading, .ace_markup.ace_heading { color: #FEF1A1; }
.ace_meta.ace_tag { color: #ff6188; }
.rstudio-themes-dark-menus .ace_editor.ace_autocomplete { background: #282c34; border: solid 1px #3e4451 !important; color: #CDCBBC; }
.rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_active-line, .rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_line-hover { background: rgba(120,220,232,0.2); border: none; }
body .ace_paren.ace_paren_color_0 { color: #61afef; }
body .ace_paren.ace_paren_color_1 { color: #ff6188; }
body .ace_paren.ace_paren_color_2 { color: #a9dc76; }
body .ace_paren.ace_paren_color_3 { color: #ab9df2; }
body .ace_paren.ace_paren_color_4 { color: #78dce8; }
body .ace_paren.ace_paren_color_5 { color: #fc9867; }
body .ace_paren.ace_paren_color_6 { color: #e6ae02; }
.terminal { background-color: #1f1f1f; color: #CDCBBC; }
.terminal .xterm-viewport { background-color: #1f1f1f; overflow-y: scroll; }
.terminal .xterm-selection div { background-color: rgba(97,175,239,0.3); position: absolute; }
.terminal.xterm-cursor-style-block.focus:not(.xterm-cursor-blink-on) .terminal-cursor { background-color: #78dce8; color: #1f1f1f; }
.terminal.focus.xterm-cursor-style-bar:not(.xterm-cursor-blink-on) .terminal-cursor::before, .terminal.focus.xterm-cursor-style-underline:not(.xterm-cursor-blink-on) .terminal-cursor::before { background-color: #78dce8; content: ''; position: absolute; }
.terminal:not(.focus) .terminal-cursor { outline: 1px solid #78dce8; outline-offset: -1px; }
.xtermInvertColor { color: #1f1f1f; }
.xtermInvertBgColor { background-color: #CDCBBC; }

/* the syntax tokens -- TX_TOKENS' `ace` column, the page's own colours */
.ace_identifier, .ace_support.ace_class { color: #CDCBBC; } /* Normal */
.ace_comment.ace_keyword.ace_operator { color: #ff6188; font-weight: bold; } /* Alert */
.ace_constant.ace_language { color: #ab9df2; } /* Constant */
.ace_comment { color: #8b8a8d; font-style: italic; } /* Comment */
.ace_constant.ace_numeric { color: #ab9df2; } /* DecVal */
.ace_invalid { color: #ff6188; text-decoration: underline; } /* Error */
.ace_support.ace_function { color: #61afef; } /* Function */
.ace_keyword { color: #ff6188; } /* Keyword */
.ace_punctuation, .ace_punctuation.ace_keyword.ace_operator, .ace_paren.ace_keyword.ace_operator { color: #939293; } /* Operator */
.ace_keyword.ace_operator { color: #ff6188; } /* SpecialChar */
.ace_string { color: #a9dc76; } /* String */

/* layering and text attributes */
.ace_layer { z-index: 3; }
.ace_layer.ace_print-margin-layer { z-index: 2; }
.ace_layer.ace_marker-layer { z-index: 1; }
.terminal { font-feature-settings: "liga" 0; position: relative; user-select: none; -ms-user-select: none; -webkit-user-select: none; }
.xtermBold { font-weight: bold; }
.xtermBlur { filter: brightness(75%); }
.xtermUnderline { text-decoration: underline; }
.xtermBlink { text-decoration: blink; }
.xtermHidden { visibility: hidden; }
.xtermItalic { font-style: italic; }
.xtermStrike { text-decoration: line-through; }

