{
    "_comments": [
        "GENERATED by txtheme::build_theme() from R/aaa-palette.R -- do not edit.",
        "Paste the `textMateRules` array below into settings.json, under editor.tokenColorCustomizations. Editor settings have no include mechanism, so this one step is a paste by construction.",
        "The editor's own foreground is a workbench colour, not a token scope: set it with workbench.colorCustomizations, editor.foreground = #CDCBBC."
    ],
    "textMateRules": [
        {
            "name": "txtheme accent",
            "scope": ["entity.name.function", "support.function", "support.other"],
            "settings": {
                "foreground": "#61afef"
            }
        },
        {
            "name": "txtheme comment",
            "scope": ["comment", "comment.block.documentation"],
            "settings": {
                "foreground": "#8b8a8d"
            }
        },
        {
            "name": "txtheme constant",
            "scope": ["constant.character.escape", "constant.language", "constant.numeric"],
            "settings": {
                "foreground": "#ab9df2"
            }
        },
        {
            "name": "txtheme ink",
            "scope": "variable",
            "settings": {
                "foreground": "#CDCBBC"
            }
        },
        {
            "name": "txtheme inline-code",
            "scope": "constant.other.placeholder",
            "settings": {
                "foreground": "#fc9867"
            }
        },
        {
            "name": "txtheme keyword",
            "scope": ["invalid.deprecated", "keyword", "keyword.control", "keyword.control.import", "meta.preprocessor"],
            "settings": {
                "foreground": "#ff6188"
            }
        },
        {
            "name": "txtheme punctuation",
            "scope": "punctuation",
            "settings": {
                "foreground": "#939293"
            }
        },
        {
            "name": "txtheme string",
            "scope": ["string", "string.quoted.other", "string.quoted.single", "string.regexp"],
            "settings": {
                "foreground": "#a9dc76"
            }
        },
        {
            "name": "txtheme comment italic",
            "scope": "comment",
            "settings": {
                "foreground": "#8b8a8d",
                "fontStyle": "italic"
            }
        },
        {
            "name": "txtheme datatype italic",
            "scope": "entity.name.type",
            "settings": {
                "foreground": "#78dce8",
                "fontStyle": "italic"
            }
        },
        {
            "name": "txtheme inline-code italic",
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#fc9867",
                "fontStyle": "italic"
            }
        },
        {
            "name": "txtheme keyword bold",
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#ff6188",
                "fontStyle": "bold"
            }
        },
        {
            "name": "txtheme keyword underline",
            "scope": "invalid",
            "settings": {
                "foreground": "#ff6188",
                "fontStyle": "underline"
            }
        }
    ]
}
